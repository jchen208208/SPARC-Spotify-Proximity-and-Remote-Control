.env
**arduino_secrets.h
.venv/
__pycache__/
.cache
build/
dist/
nohup.out
.DS_Store
.sparc_cache/
# PyCharm settings are per-machine: misc.xml stores an absolute interpreter
# path, so committing it makes each of us overwrite the others' interpreter.
.idea/

pcb_stuff/PCB_V1_NOTES.md

# KiCad writes a lock file while a project is open. It records the hostname and
# user, so committing it makes everyone else's KiCad think the project is still
# open on someone else's machine.
*.lck

# VS Code Local History extension - per-machine snapshots of edits
.history/

# KiCad plot/print output artifact - no design content
report.txt
